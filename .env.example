# Public website
NEXT_PUBLIC_SITE_URL=https://spidclimateresilience.org
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-30
NEXT_PUBLIC_SANITY_STUDIO_URL=https://studio.spidclimateresilience.org

# Server-only Sanity preview
SANITY_API_READ_TOKEN=replace-with-server-only-read-token
SANITY_PREVIEW_SECRET=replace-with-random-preview-secret

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# Resend
RESEND_API_KEY=replace-with-resend-api-key
CONTACT_FROM_EMAIL=SPiD Website <website@spidclimateresilience.org>
CONTACT_TO_EMAIL=replace-with-approved-recipient
CONTACT_REPLY_CONFIRMATION_ENABLED=false

# Runtime
VERCEL_ENV=development

# Sanity Studio
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000
SANITY_STUDIO_PRODUCTION_ORIGIN=https://spidclimateresilience.org
